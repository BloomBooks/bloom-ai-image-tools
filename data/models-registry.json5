// Model registry (JSON5)
// Add comments, trailing commas, etc.
//
// Surviving a model-key rename (e.g. the "-preview" lifecycle): set `fallbackId`
// on an entry to its successor key. openRouterService tries `id` first and, if
// that key is unavailable (retired/renamed, or no endpoint for the needed
// modality), automatically retries the request with `fallbackId`. The two keys
// are sent as SEPARATE requests, not as an OpenRouter `models` array — an array
// 400s the whole request if either key is unknown, so it can't pre-list a
// successor that isn't live yet. With `fallbackId`, the day OpenRouter retires
// the primary the app fails over on its own, no code change or redeploy needed.
[
  // GPT Image 2.5 Sunburst, from OpenAI's September 2026 image pair; its
  // sibling Flare is quicker but weaker on small details and is not offered.
  // Rates: $5/M text input, $8/M image input, $30/M image output.
  //
  // A dedicated image model: OpenRouter serves it from the images API alone,
  // and chat/completions refuses it outright ("... is an image generation
  // model and cannot be used with the chat/completions endpoint"). Hence
  // `openRouterEndpoint: "images"`, which routes it to a different request
  // shape entirely — see editImageViaImagesApi.
  //
  // It takes no reasoning parameter, so it declares no `reasoningLevels` and
  // the picker offers no reasoning control for it.
  //
  // Output size is `size`, in pixels ("1536x1024"), per OpenAI's image
  // prompting guide — not the tier token the Gemini keys take, so `maxImageSize`
  // does not apply here and the pixel rules live in snapToOpenAiImageSize.
  // OpenRouter forwards `size` and returns exactly the pixels asked for, on
  // generation and on edits alike, even though its own
  // GET /api/v1/images/models lists only aspect_ratio, quality, background, n,
  // input_references and output_compression for these keys. That list is not a
  // complete account of what these keys accept; don't treat it as one.
  // `size` and a concrete `aspect_ratio` in the same request are a 400, so a
  // request carrying a size sends aspect_ratio "auto".
  {
    id: "openai/gpt-image-2.5-sunburst",
    name: "GPT Image 2.5 Sunburst",
    description: "Good with small details. Slower than the Gemini models.",
    // Priced by tokens, so the price of a run depends on the images sent and
    // the size asked for: about $0.003 for a small generation, $0.04 for an edit
    // with three references. The rates are as published and were confirmed to
    // the cent in MODEL-COSTS.md (2026-09-14); how many tokens an image is worth
    // is encoded in lib/imageCostEstimate.ts, and the UI computes each run's
    // estimate from them. Far below GPT-5.4 Image 2's $0.24 at the identical
    // per-token rate — that model spends far more tokens per image.
    tokenPricing: {
      textInputUsdPerMillion: 5,
      imageInputUsdPerMillion: 8,
      outputUsdPerMillion: 30,
    },
    openRouterEndpoint: "images",
    // Takes pixels, snapped to the rules in snapToOpenAiImageSize.
    sizeParameter: "size",
    // From GET /api/v1/images/models: the images API normalizes these eight
    // ratios (plus "auto") for this key.
    supportedAspectRatios: ["2:3", "3:4", "9:16", "1:1", "4:3", "3:2", "16:9", "21:9"],
    // From the same listing: input_references max 16, counting the image
    // being edited.
    maxInputImages: 16,
    // The `quality` values the images API takes for this key, from the same
    // listing. Measured 2026-09-12 on a 1024x1024 generation: "low" took 7.7s
    // and "auto" about 13s, both for $0.006. Whether "low" shows in the art is
    // untested, which is why the picker starts at "auto".
    qualityLevels: ["auto", "low", "medium", "high", "xhigh", "max"],
    default: true,
  },

  {
    id: "google/gemini-3-pro-image",
    name: "Gemini 3 Pro Preview",
    badge: "Great but Expensive",
    description: "Good for changing an image. It leaves alone the parts you did not ask it to change. It follows your instructions better than the others here, but it costs more.",
    pricing: "About $0.14 per image",
    pricePerImageUsd: 0.14,
    // Measured against OpenRouter 2026-09-01: this key resolves to the
    // google/gemini-3-pro-image-20260528 snapshot, which rejects 4K. Only the
    // older preview snapshots still take 4K.
    maxImageSize: "2K",
    sizeParameter: "image_config.image_size",
    // This key lists "reasoning" in supported_parameters (checked 2026-09-11),
    // but thinking is mandatory on it: it answers effort "none" with a 400, so
    // "none" is absent here. Google documents two thinking levels for Gemini 3
    // Pro, "low" and "high"; "medium" is accepted (a 200 and an image, checked
    // 2026-09-12) but coerced to one of those two, so it is not offered. It
    // declares no initialReasoningLevel, so the picker starts at "default".
    reasoningLevels: ["default", "low", "high"],
    // For "Break Comic into Images", prefer Gemini 3.1 Flash: Pro tends to
    // "sanitize" content while extracting (observed repeatedly: it redrew an
    // open-defecation panel onto a porcelain toilet).
    // Google Gemini docs list these ratios for Gemini 3 Pro Image Preview.
    supportedAspectRatios: [
      "2:3",
      "3:4",
      "4:5",
      "9:16",
      "1:1",
      "5:4",
      "4:3",
      "3:2",
      "16:9",
      "21:9",
    ],
    // OpenRouter's GET /api/v1/images/models: input_references max 14. The
    // count includes the image being edited.
    maxInputImages: 14,
    default: false,
  },
  {
    // OpenRouter retired the "-preview" key and republished the stable
    // "google/gemini-3.1-flash-image" key (the preview now has no
    // image-output endpoint, surfacing as "404 No endpoints found that support
    // the requested output modalities: text, image"). Use the stable key.
    id: "google/gemini-3.1-flash-image",
    name: "Gemini 3.1 Flash",
    badge: "Great",
    description: "Good for changing an image. It leaves alone the parts you did not ask it to change. It does not follow your instructions quite as well as Gemini 3 Pro.",
    pricing: "About $0.07 per image",
    pricePerImageUsd: 0.07,
    // Measured against OpenRouter 2026-09-01: this key resolves to the
    // google/gemini-3.1-flash-image-20260528 snapshot, which rejects 4K.
    maxImageSize: "2K",
    sizeParameter: "image_config.image_size",
    // Recommended for "Break Comic into Images": edit-framed cleanup with
    // Flash preserves the original artwork well (Pro tends to sanitize/redraw
    // scenes), and the tool fetches captions in a separate text call, so
    // Flash's one-modality-per-turn limit doesn't matter. Keep reasoning at
    // the model default for that tool — forced reasoning invites redraws.
    // Google Gemini docs note that 3.1 Flash adds the four extreme ratios.
    supportedAspectRatios: [
      "1:8",
      "1:4",
      "2:3",
      "3:4",
      "4:5",
      "9:16",
      "1:1",
      "5:4",
      "4:3",
      "3:2",
      "16:9",
      "21:9",
      "4:1",
      "8:1",
    ],
    // Google documents two thinking levels for the 3.1 image models, "minimal"
    // (the default) and "high", and OpenRouter forwards any effort it gets.
    // Measured 2026-09-12 on Flash Lite: "low", "medium" and "high" each spent
    // ~480 reasoning tokens (the same amount), while "none", "minimal" and no
    // parameter at all spent 0. So the real dial has two positions, and that is
    // all the picker offers: "default" is no thinking, "high" is thinking.
    reasoningLevels: ["default", "high"],
    initialReasoningLevel: "high",
    // OpenRouter's GET /api/v1/images/models: input_references max 14. The
    // count includes the image being edited.
    maxInputImages: 14,
    default: false,
  },
]
